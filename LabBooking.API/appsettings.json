{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=LabBookingDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "LabBooking.API",
    "Audience": "LabBookingClients",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "RefreshTokenCleanup": {
    "IntervalHours": 1
  },
  "SeedData": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Booking": {
    "CancellationDeadlineHours": 2
  },
  "Violation": {
    "LateGraceMinutes": 15,
    "NoShowGraceMinutes": 30,
    "SweepIntervalMinutes": 5,
    "Threshold": 3,
    "WindowDays": 30,
    "RestrictionDays": 7
  },
  "Notification": {
    "ReminderHours": 1,
    "ReminderIntervalMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
