{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=LabBookingDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "LabBooking.API",
    "Audience": "LabBookingClients",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "RefreshTokenCleanup": {
    "IntervalHours": 1
  },
  "SeedData": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Booking": {
    "CancellationDeadlineHours": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
